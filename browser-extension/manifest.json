{
  "manifest_version": 3,
  "name": "拾页 · 网页摘录",
  "version": "0.1.0",
  "description": "将用户主动选择的网页片段保存为拾页私密笔记草稿。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾页网页摘录"
  }
}
